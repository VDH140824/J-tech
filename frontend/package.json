{
  "name": "jtech-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,css,html,json}\" \"../backend/src/**/*.java\" ../backend/pom.xml",
