ap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="1435" width="12" height="34" as="geometry"/></mxCell><mxCell id="30" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="1184" y="1535" width="12" height="34" as="geometry"/></mxCell><mxCell id="32" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="1635" width="12" height="34" as="geometry"/></mxCell><mxCell id="35" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="1823" width="12" height="34" as="geometry"/></mxCell><mxCell id="38" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="2023" width="12" height="34" as="geometry"/></mxCell><mxCell id="42" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="2194" width="12" height="34" as="geometry"/></mxCell><mxCell id="6" value="1. Chọn Xem chi tiết trên danh sách phản hồi" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="240" as="sourcePoint"/><mxPoint x="470" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="330" width="60" height="28" as="geometry"/></mxCell><mxCell id="9" value="Xác thực phiên/JWT và quyền Moderator — §4.2.4, §5.2.1. Không hợp lệ: chặn truy cập theo quy định chung." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="332" width="1210" height="66" as="geometry"/></mxCell><mxCell id="11" value="2. Yêu cầu chi tiết phản hồi nội dung" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="438" as="sourcePoint"/><mxPoint x="830" y="438" as="targetPoint"/></mxGeometry></mxCell><mxCell id="13" value="3. Truy vấn ticket phản hồi học thuật và ngữ cảnh liên quan" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="538" as="sourcePoint"/><mxPoint x="1190" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="4. Thông tin ticket, Student, mô tả, ảnh, Course/Chapter/Lesson/Question" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="638" as="sourcePoint"/><mxPoint x="830" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="5. ID, tên/email người gửi, thời gian, loại lỗi, trạng thái, tiêu đề, mô tả, bằng chứng và ngữ cảnh" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="738" as="sourcePoint"/><mxPoint x="470" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="[Có ảnh]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="860" width="1225" height="35" as="geometry"/></mxCell><mxCell id="19" value="6. Hiển thị ảnh đính kèm / screenshot preview" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="926" as="sourcePoint"/><mxPoint x="110" y="926" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="[Không có ảnh — 2a]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="1031" width="1225" height="35" as="geometry"/></mxCell><mxCell id="22" value="7. Không có tệp hình ảnh đính kèm." style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1097" as="sourcePoint"/><mxPoint x="110" y="1097" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="823" width="68" height="28" as="geometry"/></mxCell><mxCell id="25" value="8. Hiển thị chi tiết và nút Xem bài giảng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1235" as="sourcePoint"/><mxPoint x="110" y="1235" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="9. Chọn Xem bài giảng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1335" as="sourcePoint"/><mxPoint x="470" y="1335" as="targetPoint"/></mxGeometry></mxCell><mxCell id="29" value="10. Yêu cầu mở nội dung / câu hỏi được tham chiếu" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1435" as="sourcePoint"/><mxPoint x="830" y="1435" as="targetPoint"/></mxGeometry></mxCell><mxCell id="31" value="11. Kiểm tra nội dung tham chiếu và khả dụng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1535" as="sourcePoint"/><mxPoint x="1190" y="1535" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="12. Trạng thái nội dung" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="1635" as="sourcePoint"/><mxPoint x="830" y="1635" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="[Nội dung còn khả dụng]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="1757" width="1225" height="35" as="geometry"/></mxCell><mxCell id="36" value="13. Đích lesson / question trong Curriculum Management" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1823" as="sourcePoint"/><mxPoint x="470" y="1823" as="targetPoint"/></mxGeometry></mxCell><mxCell id="37" value="14. Mở tab mới hoặc điều hướng trực tiếp để đối chiếu" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1923" as="sourcePoint"/><mxPoint x="110" y="1923" as="targetPoint"/></mxGeometry></mxCell><mxCell id="39" value="15. Kiểm tra học liệu rồi quay lại chi tiết phản hồi" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="2023" as="sourcePoint"/><mxPoint x="470" y="2023" as="targetPoint"/></mxGeometry></mxCell><mxCell id="41" value="[Đã xóa / lưu trữ / ẩn — 3a]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="2128" width="1225" height="35" as="geometry"/></mxCell><mxCell id="43" value="16. Học liệu hoặc câu hỏi liên quan hiện không còn khả dụng hoặc đã bị lưu trữ." style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2194" as="sourcePoint"/><mxPoint x="470" y="2194" as="targetPoint"/></mxGeometry></mxCell><mxCell id="44" value="17. Hiển thị cảnh báo" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="2294" as="sourcePoint"/><mxPoint x="110" y="2294" as="targetPoint"/></mxGeometry></mxCell><mxCell id="46" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1720" width="68" height="28" as="geometry"/></mxCell><mxCell id="47" value="Không đổi trạng thái ticket. UC-49 ghi tham chiếu UC-95 ở tiền điều kiện; bảng đối chiếu và tiêu đề xác định màn hình danh sách là UC-48. Không tạo UC-95 mới." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="2422" width="1290" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="SD-17.3" name="SD-17.3 Process content feedback"><mxGraphModel grid="0" page="1" pageScale="1" pageWidth="1740" pageHeight="2873" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="SD-17.3  Process content feedback" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28" y="12" width="1685" height="38" as="geometry"/></mxCell><mxCell id="3" value="Nguồn: SRS §2.4.50 (UC-50); §5.2 Common Requirements. Điều kiện: Moderator đã đăng nhập, có đúng vai trò/quyền theo UC." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;" vertex="1" parent="1"><mxGeometry x="28" y="58" width="1685" height="42" as="geometry"/></mxCell><mxCell id="4" value="Mức tương tác theo yêu cầu SRS: các lifeline Giao diện / Hệ thống / CSDL là vai trò logic, không khẳng định tên class, API hoặc bảng chưa được đặc tả. Mũi tên liền: yêu cầu; nét đứt: phản hồi." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="28" y="108" width="1685" height="40" as="geometry"/></mxCell><mxCell id="56" value="Moderator" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="40" height="48" as="geometry"/></mxCell><mxCell id="57" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="230" as="sourcePoint"/><mxPoint x="110" y="2838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="58" value="Giao diện" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="260" height="48" as="geometry"/></mxCell><mxCell id="59" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="230" as="sourcePoint"/><mxPoint x="470" y="2838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="60" value="Hệ thống J-Tech" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="260" height="48" as="geometry"/></mxCell><mxCell id="61" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="230" as="sourcePoint"/><mxPoint x="830" y="2838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="62" value="Cơ sở dữ liệu" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="170" width="260" height="48" as="geometry"/></mxCell><mxCell id="63" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="230" as="sourcePoint"/><mxPoint x="1190" y="2838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="64" value="Email Service" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="1420" y="170" width="260" height="48" as="geometry"/></mxCell><mxCell id="65" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="230" as="sourcePoint"/><mxPoint x="1550" y="2838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="730" width="1650" height="70" as="geometry"/></mxCell><mxCell id="23" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="30" y="1223" as="sourcePoint"/><mxPoint x="1705" y="1223" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="42" y="1782" as="sourcePoint"/><mxPoint x="1693" y="1782" as="targetPoint"/></mxGeometry></mxCell><mxCell id="48" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="42" y="1394" width="1651" height="1178" as="geometry"/></mxCell><mxCell id="50" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="935" width="1675" height="1675" as="geometry"/></mxCell><mxCell id="52" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="2634" width="1650" height="70" as="geometry"/></mxCell><mxCell id="6" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="328" width="12" height="34" as="geometry"/></mxCell><mxCell id="8" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="428" width="12" height="34" as="geometry"/></mxCell><mxCell id="10" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="470" y="528" width="12" height="44" as="geometry"/></mxCell><mxCell id="12" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="640" width="12" height="34" as="geometry"/></mxCell><mxCell id="17" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="830" y="838" width="12" height="44" as="geometry"/></mxCell><mxCell id="20" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="1038" width="12" height="34" as="geometry"/></mxCell><mxCell id="25" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="1184" y="1309" width="12" height="34" as="geometry"/></mxCell><mxCell id="28" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="1497" width="12" height="34" as="geometry"/></mxCell><mxCell id="30" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="1597" width="12" height="34" as="geometry"/></mxCell><mxCell id="35" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="1868" width="12" height="34" as="geometry"/></mxCell><mxCell id="37" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="1184" y="1968" width="12" height="34" as="geometry"/></mxCell><mxCell id="39" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="2068" width="12" height="34" as="geometry"/></mxCell><mxCell id="41" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="1544" y="2168" width="12" height="34" as="geometry"/></mxCell><mxCell id="43" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="2268" width="12" height="34" as="geometry"/></mxCell><mxCell id="45" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="2368" width="12" height="34" as="geometry"/></mxCell><mxCell id="5" value="Tiền điều kiện UC-50: đang xem ticket nội dung ở Chờ xử lý hoặc Đang xử lý. Sơ đồ giữ nguyên luồng UC-50; các mâu thuẫn nguồn được ghi cuối trang." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="230" width="1650" height="58" as="geometry"/></mxCell><mxCell id="7" value="1. Chọn Đang xử lý / Đã xử lý / Từ chối" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="328" as="sourcePoint"/><mxPoint x="470" y="328" as="targetPoint"/></mxGeometry></mxCell><mxCell id="9" value="2. Nhập Ghi chú xử lý; chọn Xác nhận xử lý" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="428" as="sourcePoint"/><mxPoint x="470" y="428" as="targetPoint"/></mxGeometry></mxCell><mxCell id="11" value="3. Kiểm tra đầu vào phía client; trim ghi chú" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="528" as="sourcePoint"/><mxPoint x="476" y="566" as="targetPoint"/><Array as="points"><mxPoint x="595" y="528"/><mxPoint x="595" y="566"/></Array></mxGeometry></mxCell><mxCell id="13" value="4. Gửi trạng thái mới và ghi chú" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="640" as="sourcePoint"/><mxPoint x="830" y="640" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="730" width="60" height="28" as="geometry"/></mxCell><mxCell id="16" value="Xác thực phiên/JWT và quyền Moderator — §4.2.4, §5.2.1. Không hợp lệ: chặn truy cập theo quy định chung." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="732" width="1570" height="66" as="geometry"/></mxCell><mxCell id="18" value="5. Sanitize ghi chú; kiểm tra chuyển trạng thái hợp lệ và ghi chú bắt buộc khi Đã xử lý/Từ chối" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="838" as="sourcePoint"/><mxPoint x="836" y="876" as="targetPoint"/><Array as="points"><mxPoint x="955" y="838"/><mxPoint x="955" y="876"/></Array></mxGeometry></mxCell><mxCell id="19" value="[Đã xử lý/Từ chối nhưng ghi chú trống — 3a]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="972" width="1585" height="35" as="geometry"/></mxCell><mxCell id="21" value="6. Vui lòng nhập ghi chú xử lý chi tiết để phản hồi kết quả cho sinh viên." style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1038" as="sourcePoint"/><mxPoint x="470" y="1038" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="7. Tô đỏ ghi chú; dừng lưu" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1138" as="sourcePoint"/><mxPoint x="110" y="1138" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="[Dữ liệu và chuyển trạng thái hợp lệ]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="1243" width="1585" height="35" as="geometry"/></mxCell><mxCell id="26" value="8. Cập nhật có kiểm tra xung đột: trạng thái, ghi chú, Moderator xử lý, thời gian hoàn tất; lưu lịch sử xử lý theo mô tả UC" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1309" as="sourcePoint"/><mxPoint x="1190" y="1309" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="[Ticket vừa bị Moderator khác cập nhật — 4a]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="1431" width="1561" height="35" as="geometry"/></mxCell><mxCell id="29" value="9. Xung đột cập nhật đồng thời; không ghi đè" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="1497" as="sourcePoint"/><mxPoint x="830" y="1497" as="targetPoint"/></mxGeometry></mxCell><mxCell id="31" value="10. Phiếu phản hồi này vừa được xử lý bởi một kiểm duyệt viên khác. Vui lòng tải lại trang để xem dữ liệu mới nhất." style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1597" as="sourcePoint"/><mxPoint x="470" y="1597" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="11. Hiển thị cảnh báo tải lại" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1697" as="sourcePoint"/><mxPoint x="110" y="1697" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="[Cập nhật thành công]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="1802" width="1561" height="35" as="geometry"/></mxCell><mxCell id="36" value="12. Dữ liệu xử lý đã lưu" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="1868" as="sourcePoint"/><mxPoint x="830" y="1868" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" value="13. Tạo thông báo in-app cho Student gửi phản hồi" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1968" as="sourcePoint"/><mxPoint x="1190" y="1968" as="targetPoint"/></mxGeometry></mxCell><mxCell id="40" value="14. Thông báo được ghi nhận" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="2068" as="sourcePoint"/><mxPoint x="830" y="2068" as="targetPoint"/></mxGeometry></mxCell><mxCell id="42" value="15. Gửi email thông báo kèm ghi chú đến Student" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=682;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2168" as="sourcePoint"/><mxPoint x="1550" y="2168" as="targetPoint"/></mxGeometry></mxCell><mxCell id="44" value="16. Kết quả gửi email theo luồng thành công" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=682;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="2268" as="sourcePoint"/><mxPoint x="830" y="2268" as="targetPoint"/></mxGeometry></mxCell><mxCell id="46" value="17. Cập nhật trạng thái và gửi phản hồi thành công" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2368" as="sourcePoint"/><mxPoint x="470" y="2368" as="targetPoint"/></mxGeometry></mxCell><mxCell id="47" value="18. Hiển thị thành công; làm mới chi tiết/danh sách" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="2468" as="sourcePoint"/><mxPoint x="110" y="2468" as="targetPoint"/></mxGeometry></mxCell><mxCell id="49" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="1394" width="68" height="28" as="geometry"/></mxCell><mxCell id="51" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="935" width="68" height="28" as="geometry"/></mxCell><mxCell id="53" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="2634" width="60" height="28" as="geometry"/></mxCell><mxCell id="54" value="Ghi audit bất biến cho can thiệp quản trị theo §4.2.4 và BR-07; SRS không đặc tả vị trí gọi chi tiết." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="2636" width="1570" height="66" as="geometry"/></mxCell><mxCell id="55" value="Điểm chưa thống nhất, không tự sửa: UC-50 bước 7–8 đặt gửi in-app/email sau cập nhật; BR-54/BR-102 nhấn mạnh khi Resolved/Rejected. UC-50 dùng BR-105/106, phụ lục đánh số BR-100/102. Không thêm nhánh email lỗi vì UC-50 không mô tả." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="2732" width="1650" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="SD-17.4" name="SD-17.4 View technical feedback list"><mxGraphModel grid="0" page="1" pageScale="1" pageWidth="1380" pageHeight="2211" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="SD-17.4  View technical feedback list" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28" y="12" width="1325" height="38" as="geometry"/></mxCell><mxCell id="3" value="Nguồn: SRS §2.4.63 (UC-63); §5.2 Common Requirements. Điều kiện: Administrator đã đăng nhập, có đúng vai trò/quyền theo UC." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;" vertex="1" parent="1"><mxGeometry x="28" y="58" width="1325" height="42" as="geometry"/></mxCell><mxCell id="4" value="Mức tương tác theo yêu cầu SRS: các lifeline Giao diện / Hệ thống / CSDL là vai trò logic, không khẳng định tên class, API hoặc bảng chưa được đặc tả. Mũi tên liền: yêu cầu; nét đứt: phản hồi." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="28" y="108" width="1325" height="40" as="geometry"/></mxCell><mxCell id="43" value="Administrator" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="40" height="48" as="geometry"/></mxCell><mxCell id="44" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="230" as="sourcePoint"/><mxPoint x="110" y="2176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="45" value="Giao diện" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="260" height="48" as="geometry"/