"><mxGeometry x="824" y="1126" width="12" height="34" as="geometry"/></mxCell><mxCell id="24" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="1184" y="1226" width="12" height="34" as="geometry"/></mxCell><mxCell id="26" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="1326" width="12" height="34" as="geometry"/></mxCell><mxCell id="29" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="1514" width="12" height="34" as="geometry"/></mxCell><mxCell id="34" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="1785" width="12" height="34" as="geometry"/></mxCell><mxCell id="41" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="2061" width="12" height="34" as="geometry"/></mxCell><mxCell id="6" value="1. Mở Nội dung phản hồi" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="240" as="sourcePoint"/><mxPoint x="470" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8" value="2. Yêu cầu tải danh sách theo tiêu chí hiện tại" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="340" as="sourcePoint"/><mxPoint x="830" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="10" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="430" width="60" height="28" as="geometry"/></mxCell><mxCell id="11" value="Xác thực phiên/JWT và quyền đúng vai trò — §4.2.4, §5.2.1. Không hợp lệ: chặn truy cập theo quy định chung." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="432" width="1210" height="66" as="geometry"/></mxCell><mxCell id="13" value="3. Chỉ lấy phản hồi học thuật; ưu tiên Chờ xử lý, mới nhất trước" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="538" as="sourcePoint"/><mxPoint x="1190" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="4. Kết quả truy vấn" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="638" as="sourcePoint"/><mxPoint x="830" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="5. Mã, khóa học, bài học, loại nội dung, tiêu đề, người gửi, ngày gửi, trạng thái" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="738" as="sourcePoint"/><mxPoint x="470" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="6. Hiển thị danh sách / trạng thái rỗng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="838" as="sourcePoint"/><mxPoint x="110" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="19" value="[Tìm kiếm / lọc / chuyển trang]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="960" width="1225" height="35" as="geometry"/></mxCell><mxCell id="21" value="7. Chọn Course, Bài học, Trạng thái; nhập tiêu đề / tên Student / mã nội dung và Enter; hoặc chuyển trang" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1026" as="sourcePoint"/><mxPoint x="470" y="1026" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="8. Gửi tiêu chí tìm kiếm, lọc và trang" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1126" as="sourcePoint"/><mxPoint x="830" y="1126" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" value="9. Truy vấn phản hồi nội dung theo tiêu chí; mặc định 10 hoặc 20 bản ghi/trang" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1226" as="sourcePoint"/><mxPoint x="1190" y="1226" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="10. Kết quả tương ứng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="1326" as="sourcePoint"/><mxPoint x="830" y="1326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="28" value="[Có kết quả]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="1448" width="1201" height="35" as="geometry"/></mxCell><mxCell id="30" value="11. Danh sách khớp tiêu chí" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1514" as="sourcePoint"/><mxPoint x="470" y="1514" as="targetPoint"/></mxGeometry></mxCell><mxCell id="31" value="12. Làm mới bảng phản hồi" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1614" as="sourcePoint"/><mxPoint x="110" y="1614" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="[Không có kết quả — 5a]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="1719" width="1201" height="35" as="geometry"/></mxCell><mxCell id="35" value="13. Không tìm thấy phản hồi nội dung nào phù hợp với điều kiện tìm kiếm." style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1785" as="sourcePoint"/><mxPoint x="470" y="1785" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" value="14. Hiển thị thông báo rỗng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1885" as="sourcePoint"/><mxPoint x="110" y="1885" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="1411" width="68" height="28" as="geometry"/></mxCell><mxCell id="40" value="opt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="923" width="68" height="28" as="geometry"/></mxCell><mxCell id="42" value="15. Chọn Xem chi tiết" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="2061" as="sourcePoint"/><mxPoint x="470" y="2061" as="targetPoint"/></mxGeometry></mxCell><mxCell id="44" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="2151" width="60" height="28" as="geometry"/></mxCell><mxCell id="45" value="SD-17.2 — UC-49" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="2153" width="1210" height="66" as="geometry"/></mxCell><mxCell id="46" value="Chỉ đọc. UC-48 dẫn BR-105; nội dung tương ứng tại phụ lục là BR-100. Giữ nguyên phạm vi phản hồi học thuật." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="2249" width="1290" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram>
