w=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="538" as="sourcePoint"/><mxPoint x="476" y="576" as="targetPoint"/><Array as="points"><mxPoint x="595" y="538"/><mxPoint x="595" y="576"/></Array></mxGeometry></mxCell><mxCell id="15" value="4. Gửi các mức xu và trạng thái áp dụng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="650" as="sourcePoint"/><mxPoint x="830" y="650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="740" width="60" height="28" as="geometry"/></mxCell><mxCell id="18" value="Xác thực phiên/JWT và quyền Administrator — §4.2.4, §5.2.1. Không hợp lệ: chặn truy cập theo quy định chung." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="742" width="1210" height="66" as="geometry"/></mxCell><mxCell id="20" value="5. Kiểm tra server: mọi số xu là số nguyên dương &gt; 0" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="848" as="sourcePoint"/><mxPoint x="836" y="886" as="targetPoint"/><Array as="points"><mxPoint x="955" y="848"/><mxPoint x="955" y="886"/></Array></mxGeometry></mxCell><mxCell id="21" value="[Âm / 0 / không phải số nguyên — 5a]" style="html=0;fontFami