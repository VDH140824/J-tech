Cell><mxCell id="13" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="470" y="638" width="12" height="44" as="geometry"/></mxCell><mxCell id="22" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="1180" width="12" height="34" as="geometry"/></mxCell><mxCell id="27" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="830" y="1378" width="12" height="44" as="geometry"/></mxCell><mxCell id="32" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="1544" y="1588" width="12" height="34" as="geometry"/></mxCell><mxCell id="34" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="1688" width="12" height="34" as="geometry"/></mxCell><mxCell id="36" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="1788" width="12" height="34" as="geometry"/></mxCell><mxCell id="38" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="1888" width="12" height="34" as="geometry"/></mxCell><mxCell id="40" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="1988" width="12" height="34" as="geometry"/></mxCell><mxCell id="42" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="1184" y="2088" width="12" height="34" as="geometry"/></mxCell><mxCell id="44" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="2188" width="12" height="34" as="geometry"/></mxCell><mxCell id="46" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="2288" width="12" height="34" as="geometry"/></mxCell><mxCell id="6" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="230" width="60" height="28" as="geometry"/></mxCell><mxCell id="7" value="SD-33.2 — danh sách vật phẩm" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="232" width="1570" height="66" as="geometry"/></mxCell><mxCell id="9" value="1. Chọn Chỉnh sửa vật phẩm" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="338" as="sourcePoint"/><mxPoint x="470" y="338" as="targetPoint"/></mxGeometry></mxCell><mxCell id="10" value="2. Hiển thị dữ liệu vật phẩm để chỉnh sửa" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="438" as="sourcePoint"/><mxPoint x="110" y="438" as="targetPoint"/></mxGeometry></mxCell><mxCell id="12" value="3. Loại Huy hiệu/Khung/Theme, tên, mô tả, giá xu và graphic asset" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="538" as="sourcePoint"/><mxPoint x="470" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14" value="4. Trim; kiểm tra bắt buộc và giá phải là số; kiểm tra ảnh JPG/JPEG/PNG/WEBP ≤ 3 MB" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="638" as="sourcePoint"/><mxPoint x="476" y="676" as="targetPoint"/><Array as="points"><mxPoint x="595" y="638"/><mxPoint x="595" y="676"/></Array></mxGeometry></mxCell><mxCell id="15" value="[Thiếu bắt buộc / giá không phải số — 4a]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="772" width="1585" height="35" as="geometry"/></mxCell><mxCell id="16" value="5. Hiển thị lỗi bắt buộc (MSG09); yêu cầu sửa" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="838" as="sourcePoint"/><mxPoint x="110" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="[Ảnh sai định dạng / quá 3 MB — 4b]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="943" width="1585" height="35" as="geometry"/></mxCell><mxCell id="19" value="6. Ảnh không thuộc định dạng cho phép hoặc dung lượng lớn hơn 3MB (MSG24); chọn lại" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1009" as="sourcePoint"/><mxPoint x="110" y="1009" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="[Dữ liệu / ảnh hợp lệ]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="1114" width="1585" height="35" as="geometry"/></mxCell><mxCell id="23" value="7. Gửi dữ liệu và ảnh được chọn để kiểm tra" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1180" as="sourcePoint"/><mxPoint x="830" y="1180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="1270" width="60" height="28" as="geometry"/></mxCell><mxCell id="26" value="Xác thực phiên/JWT và quyền Administrator — §4.2.4, §5.2.1. Không hợp lệ: chặn truy cập theo quy định chung." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1272" width="1570" height="66" as="geometry"/></mxCell><mxCell id="28" value="8. Kiểm tra lại phía server: trường bắt buộc, kiểu giá, quy tắc ảnh" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1378" as="sourcePoint"/><mxPoint x="836" y="1416" as="targetPoint"/><Array as="points"><mxPoint x="955" y="1378"/><mxPoint x="955" y="1416"/></Array></mxGeometry></mxCell><mxCell id="30" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="1480" width="60" height="28" as="geometry"/></mxCell><mxCell id="31" value="Nếu server phát hiện dữ liệu / ảnh không hợp lệ: trả lỗi MSG09/MSG24 tương ứng; không lưu thay đổi." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1482" width="1570" height="66" as="geometry"/></mxCell><mxCell id="33" value="9. Upload graphic asset lên Cloudinary — bước 5 UC-56" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=682;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1588" as="sourcePoint"/><mxPoint x="1550" y="1588" as="targetPoint"/></mxGeometry></mxCell><mxCell id="35" value="10. Trả secure URL" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=682;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="1688" as="sourcePoint"/><mxPoint x="830" y="1688" as="targetPoint"/></mxGeometry></mxCell><mxCell id="37" value="11. Tham chiếu ảnh đã upload" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1788" as="sourcePoint"/><mxPoint x="470" y="1788" as="targetPoint"/></mxGeometry></mxCell><mxCell id="39" value="12. Chọn Lưu vật phẩm — bước 6 UC-56" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1888" as="sourcePoint"/><mxPoint x="470" y="1888" as="targetPoint"/></mxGeometry></mxCell><mxCell id="41" value="13. Yêu cầu lưu dữ liệu và secure URL" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1988" as="sourcePoint"/><mxPoint x="830" y="1988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="43" value="14. Cập nhật thông tin vật phẩm và tham chiếu ảnh" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2088" as="sourcePoint"/><mxPoint x="1190" y="2088" as="targetPoint"/></mxGeometry></mxCell><mxCell id="45" value="15. Bản ghi vật phẩm đã lưu" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="2188" as="sourcePoint"/><mxPoint x="830" y="2188" as="targetPoint"/></mxGeometry></mxCell><mxCell id="47" value="16. Lưu vật phẩm thành công! (MSG08)" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2288" as="sourcePoint"/><mxPoint x="470" y="2288" as="targetPoint"/></mxGeometry></mxCell><mxCell id="48" value="17. Hiển thị thành công" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="2388" as="sourcePoint"/><mxPoint x="110" y="2388" as="targetPoint"/></mxGeometry></mxCell><mxCell id="50" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="735" width="68" height="28" as="geometry"/></mxCell><mxCell id="52" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="2516" width="60" height="28" as="geometry"/></mxCell><mxCell id="53" value="Audit quản trị theo §4.2.4, BR-07." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="2518" width="1570" height="66" as="geometry"/></mxCell><mxCell id="54" value="Giữ thứ tự UC-56: upload trước khi chọn Lưu. UC-56 không mô tả nhánh Cloudinary lỗi, cleanup, trạng thái mặc định hoặc ràng buộc giá &gt; 0; không tự thêm. Với Update, SRS không tách rõ trường hợp giữ nguyên ảnh nên sơ đồ thể hiện luồng chỉnh sửa có chọn asset như bước 4–5." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="2614" width="1650" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="SD-33.4" name="SD-33.4 Delete / hide store item"><mxGraphModel grid="0" page="1" pageScale="1" pageWidth="1380" pageHeight="1561" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="SD-33.4  Delete / hide store item" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28" y="12" width="1325" height="38" as="geometry"/></mxCell><mxCell id="3" value="Nguồn: SRS §2.4.56 (UC-56); §5.2 Common Requirements. Điều kiện: Administrator đã đăng nhập, có đúng vai trò/quyền theo UC." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;" vertex="1" parent="1"><mxGeometry x="28" y="58" width="1325" height="42" as="geometry"/></mxCell><mxCell id="4" value="Mức tương tác theo yêu cầu SRS: các lifeline Giao diện / Hệ thống / CSDL là vai trò logic, không khẳng định tên class, API hoặc bảng chưa được đặc tả. Mũi tên liền: yêu cầu; nét đứt: phản hồi." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="28" y="108" width="1325" height="40" as="geometry"/></mxCell><mxCell id="30" value="Administrator" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="40" height="48" as="geometry"/></mxCell><mxCell id="31" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="230" as="sourcePoint"/><mxPoint x="110" y="1526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="Giao diện" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="260" height="48" as="geometry"/></mxCell><mxCell id="33" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="230" as="sourcePoint"/><mxPoint x="470" y="1526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="Hệ thống J-Tech" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="700" y="170" width="260" height="48" as="geometry"/></mxCell><mxCell id="35" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="230" as="sourcePoint"/><mxPoint x="830" y="1526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" value="Cơ sở dữ liệu" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="1060" y="170" width="260" height="48" as="geometry"/></mxCell><mxCell id="37" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="230" as="sourcePoint"/><mxPoint x="1190" y="1526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="6" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="326" width="1290" height="70" as="geometry"/></mxCell><mxCell id="13" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="624" width="1290" height="70" as="geometry"/></mxCell><mxCell id="26" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="1330" width="1290" height="70" as="geometry"/></mxCell><mxCell id="9" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="434" width="12" height="34" as="geometry"/></mxCell><mxCell id="11" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="534" width="12" height="34" as="geometry"/></mxCell><mxCell id="16" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="1184" y="732" width="12" height="34" as="geometry"/></mxCell><mxCell id="18" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="832" width="12" height="34" as="geometry"/></mxCell><mxCell id="20" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="932" width="12" height="34" as="geometry"/></mxCell><mxCell id="23" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="830" y="1132" width="12" height="44" as="geometry"/></mxCell><mxCell id="5" value="Giới hạn nguồn cần xác nhận: tên SD trong bảng là Delete / hide; UC-56 chỉ quy định Deactivate/Hide. Phần dưới chỉ biểu diễn nhánh được SRS mô tả; không tự dựng thao tác Delete." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="230" width="1290" height="66" as="geometry"/></mxCell><mxCell id="7" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="326" width="60" height="28" as="geometry"/></mxCell><mxCell id="8" value="SD-33.2 — danh sách vật phẩm" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="328" width="1210" height="66" as="geometry"/></mxCell><mxCell id="10" value="1. Chuyển trạng thái vật phẩm sang Tạm ẩn — UC-56 7a" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="434" as="sourcePoint"/><mxPoint x="470" y="434" as="targetPoint"/></mxGeometry></mxCell><mxCell id="12" value="2. Yêu cầu lưu trạng thái ẩn" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="534" as="sourcePoint"/><mxPoint x="830" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="14" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="624" width="60" height="28" as="geometry"/></mxCell><mxCell id="15" value="Xác thực phiên/JWT và quyền Administrator — §4.2.4, §5.2.1. Không hợp lệ: chặn truy cập theo quy định chung." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="626" width="1210" height="66" as="geometry"/></mxCell><mxCell id="17" value="3. Lưu trạng thái ẩn của vật phẩm" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="732" as="sourcePoint"/><mxPoint x="1190" y="732" as="targetPoint"/></mxGeometry></mxCell><mxCell id="19" value="4. Trạng thái đã lưu" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="832" as="sourcePoint"/><mxPoint x="830" y="832" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="5. Vật phẩm đã ẩn; kết quả lưu theo UC-56" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="932" as="sourcePoint"/><mxPoint x="470" y="932" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="6. Hiển thị trạng thái Ẩn" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1032" as="sourcePoint"/><mxPoint x="110" y="1032" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="7. Áp dụng ngay việc không hiển thị vật phẩm tại cửa hàng Student" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1132" as="sourcePoint"/><mxPoint x="836" y="1170" as="targetPoint"/><Array as="points"><mxPoint x="955" y="1132"/><mxPoint x="955" y="1170"/></Array></mxGeometry></mxCell><mxCell id="25" value="BR-04: Student đã đổi vẫn truy cập và trang bị vật phẩm trong inventory. §5.2.6: store_item đã được tham chiếu bởi giao dịch xu không được hard-delete. Không xóa inventory, không thu hồi vật phẩm và không hoàn xu." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="1234" width="1290" height="66" as="geometry"/></mxCell><mxCell id="27" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="1330" width="60" height="28" as="geometry"/></mxCell><mxCell id="28" value="Audit quản trị theo §4.2.4, BR-07." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1332" width="1210" height="66" as="geometry"/></mxCell><mxCell id="29" value="Không đặc tả hard-delete ngay cả khi chưa từng đổi: SRS chưa quy định thao tác đó. Cần quyết định của người dùng trước khi bổ sung." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="1428" width="1290" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>