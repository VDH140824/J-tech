ry"><mxPoint x="830" y="4513" as="sourcePoint"/><mxPoint x="470" y="4513" as="targetPoint"/></mxGeometry></mxCell><mxCell id="89" value="26. Hiển thị xác nhận gửi thành công" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="4613" as="sourcePoint"/><mxPoint x="110" y="4613" as="targetPoint"/></mxGeometry></mxCell><mxCell id="91" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="66" y="3518" width="68" height="28" as="geometry"/></mxCell><mxCell id="93" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="54" y="2747" width="68" height="28" as="geometry"/></mxCell><mxCell id="95" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="2188" width="68" height="28" as="geometry"/></mxCell><mxCell id="97" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1417" width="68" height="28" as="geometry"/></mxCell><mxCell id="98" value="SRS không đặt tên cụ thể cho trạng thái ban đầu ở UC-34. Không tự gán enum, endpoint, cơ chế rollback hoặc chính sách retry." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="4855" width