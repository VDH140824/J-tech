4" as="geometry"/></mxCell><mxCell id="6" value="1. Chọn Send Feedback / Report a Bug" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="240" as="sourcePoint"/><mxPoint x="470" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="330" width="60" height="28" as="geometry"/></mxCell><mxCell id="9" value="Xác thực phiên/JWT và quyền Student đang hoạt động — §4.2.4, §5.2.1. Không hợp lệ: chặn truy cập theo quy định chung." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="332" width="1210" height="66" as="geometry"/></mxCell><mxCell id="10" value="2. Hiển thị loại phản hồi, mô tả, tham chiếu nội dung và đính kèm ảnh" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="438" as="sourcePoint"/><mxPoint x="110" y="438" as="targetPoint"/></mxGeometry></mxCell><mxCell id="12" value="3. Chọn Content Feedback hoặc Technical Issue" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="538" as="sourcePoint"/><mxPoint x="470" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="13" value="[Content Feedback]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="660" width="1225" height="35" as="geometry"/></mxCell><mxCell id="14" value="[Mở từ trang nội dung]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="748" width="1201" height="35" as="geometry"/></mxCell><mxCell id="15" value="4. Điền sẵn tham chiếu lesson / lecture / question" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="814" as="sourcePoint"/><mxPoint x="110" y="814" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="[Mở biểu mẫu độc lập]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="919" width="1201" height="35" as="geometry"/></mxCell><mxCell id="19" value="5. Chọn lesson / lecture / question liên quan" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="985" as="sourcePoint"/><mxPoint x="470" y="985" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="711" width="68" height="28" as="geometry"/></mxCell><mxCell id="23" value="[Technical Issue — A1]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="1128" width="1225" height="35" as="geometry"/></mxCell><mxCell id="25" value="6. Mô tả chức năng bị ảnh hưởng; không bắt buộc tham chiếu nội dung" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1194" as="sourcePoint"/><mxPoint x="470" y="1194" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="623" width="68" height="28" as="geometry"/></mxCell><mxCell id="29" value="7. Nhập mô tả; tùy chọn đính kèm ảnh" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1332" as="sourcePoint"/><mxPoint x="470" y="1332" as="targetPoint"/></mxGeometry></mxCell><mxCell id="30" value="[Hủy trước Submit — A3]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="1454" width="1225" height="35" as="geometry"/></mxCell><mxCell id="32" value="8. Hủy gửi" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1520" as="sourcePoint"/><mxPoint x="470" y="1520" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="Kết thúc nhánh: không tạo báo cáo" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="1610" width="1290" height="58" as="geometry"/></mxCell><mxCell id="35" value="[Submit]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="1713" width="1225" height="35" as="geometry"/></mxCell><mxCell id="37" value="9. Chọn Submit" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1779" as="sourcePoint"/><mxPoint x="470" y="1779" as="targetPoint"/></mxGeometry></mxCell><mxCell id="39" value="10. Trim, kiểm tra đầu vào phía client (§5.2.2)" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1879" as="sourcePoint"/><mxPoint x="476" y="1917" as="targetPoint"/><Array as="points"><mxPoint x="595" y="1879"/><mxPoint x="595" y="1917"/></Array></mxGeometry></mxCell><mxCell id="41" value="11. Gửi loại báo cáo, mô tả, tham chiếu và ảnh nếu có" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1991" as="sourcePoint"/><mxPoint x="830" y="1991" as="targetPoint"/></mxGeometry></mxCell><mxCell id="43" value="12. Kiểm tra bắt buộc, sanitize mô tả; kiểm tra tham chiếu nội dung khi áp dụng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2091" as="sourcePoint"/><mxPoint x="836" y="2129" as="targetPoint"/><Array as="points"><mxPoint x="955" y="2091"/><mxPoint x="955" y="2129"/></Array></mxGeometry></mxCell><mxCell id="44" value="[Thiếu dữ liệu / tham chiếu không hợp lệ — E1]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="2225" width="1201" height="35" as="geometry"/></mxCell><mxCell id="46" value="13. Chỉ ra dữ liệu cần sửa" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2291" as="sourcePoint"/><mxPoint x="470" y="2291" as="targetPoint"/></mxGeometry></mxCell><mxCell id="47" value="14. Yêu cầu sửa thông tin" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="2391" as="sourcePoint"/><mxPoint x="110" y="2391" as="targetPoint"/></mxGeometry></mxCell><mxCell id="48" value="Kết thúc nhánh: chưa báo gửi thành công" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="2481" width="1290" height="58" as="geometry"/></mxCell><mxCell id="50" value="[Chi tiết hợp lệ]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="2584" width="1201" height="35" as="geometry"/></mxCell><mxCell id="52" value="15. Kiểm tra ảnh nếu có: JPG/JPEG/PNG/WEBP; tối đa 3 MB/tệp (§5.2.4)" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2650" as="sourcePoint"/><mxPoint x="836" y="2688" as="targetPoint"/><Array as="points"><mxPoint x="955" y="2650"/><mxPoint x="955" y="2688"/></Array></mxGeometry></mxCell><mxCell id="53" value="[Ảnh không hợp lệ — E2]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="134" y="2784" width="1177" height="35" as="geometry"/></mxCell><mxCell id="55" value="16. Yêu cầu bỏ hoặc thay ảnh" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2850" as="sourcePoint"/><mxPoint x="470" y="2850" as="targetPoint"/></mxGeometry></mxCell><mxCell id="56" value="17. Hiển thị lỗi tệp đính kèm" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="2950" as="sourcePoint"/><mxPoint x="110" y="2950" as="targetPoint"/></mxGeometry></mxCell><mxCell id="57" value="Kết thúc nhánh: chưa báo gửi thành công" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="3040" width="1290" height="58" as="geometry"/></mxCell><mxCell id="59" value="[Không có ảnh — A2 / ảnh hợp lệ]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="134" y="3143" width="1177" height="35" as="geometry"/></mxCell><mxCell id="60" value="[Có ảnh hợp lệ]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="146" y="3231" width="1153" height="35" as="geometry"/></mxCell><mxCell id="62" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="3287" width="60" height="28" as="geometry"/></mxCell><mxCell id="63" value="Lưu ảnh theo quy định Cloudinary §5.2.4; UC-34 không đặc tả thứ tự upload chi tiết." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="3289" width="1210" height="66" as="geometry"/></mxCell><mxCell id="65" value="opt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="66" y="3194" width="68" height="28" as="geometry"/></mxCell><mxCell id="67" value="18. Lưu báo cáo: trạng thái ban đầu, thời gian gửi, người gửi, tham chiếu nếu có và đính kèm được chấp nhận" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="3433" as="sourcePoint"/><mxPoint x="1190" y="3433" as="targetPoint"/></mxGeometry></mxCell><mxCell id="68" value="[Không lưu được báo cáo hoặc đính kèm — E3]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="146" y="3555" width="1153" height="35" as="geometry"/></mxCell><mxCell id="70" value="19. Lưu thất bại" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="3621" as="sourcePoint"/><mxPoint x="830" y="3621" as="targetPoint"/></mxGeometry></mxCell><mxCell id="72" value="20. Lỗi gửi báo cáo; giữ thông tin đã nhập" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="3721" as="sourcePoint"/><mxPoint x="470" y="3721" as="targetPoint"/></mxGeometry></mxCell><mxCell id="73" value="21. Cho phép sửa hoặc thử lại" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="3821" as="sourcePoint"/><mxPoint x="110" y="3821" as="targetPoint"/></mxGeometry></mxCell><mxCell id="75" value="[Lưu thành công]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="146" y="3926" width="1153" height="35" as="geometry"/></mxCell><mxCell id="77" value="22. Báo cáo đã lưu" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="3992" as="sourcePoint"/><mxPoint x="830" y="3992" as="targetPoint"/></mxGeometry></mxCell><mxCell id="78" value="[Content Feedback]" style="html=0;fon