ometry"><mxPoint x="1190" y="1419" as="sourcePoint"/><mxPoint x="830" y="1419" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="10. Lưu cấu hình quy tắc thưởng thành công! (MSG06)" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1519" as="sourcePoint"/><mxPoint x="470" y="1519" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="11. Hiển thị toast thành công" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1619" as="sourcePoint"/><mxPoint x="110" y="1619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="35" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="945" width="68" height="28" as="geometry"/></mxCell><mxCell id="37" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="1747" width="60" height="28" as="geometry"/></mxCell><mxCell id="38" value="Audit bất biến cho can thiệp quản trị — §4.2.4, BR-07." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1749" width="1210" height="66" as="geometry"/></mxCell><mxCell id="39" value="BR-03: áp dụng cho hoàn thành hoạt động trong tương lai; không điều chỉnh số dư lịch sử. UC-54 dẫn BR-30 về lần hoàn thành đầu; nội dung này ở phụ lục BR-32. Không phát sinh bước cộng xu trong cấu hình." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="1845" width="1290" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram>
