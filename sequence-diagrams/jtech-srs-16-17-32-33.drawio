=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="1219" width="1201" height="35" as="geometry"/></mxCell><mxCell id="26" value="8. No submitted feedback" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1285" as="sourcePoint"/><mxPoint x="470" y="1285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="9. Hiển thị trạng thái chưa có phản hồi" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1385" as="sourcePoint"/><mxPoint x="110" y="1385" as="targetPoint"/></mxGeometry></mxCell><mxCell id="29" value="[Có báo cáo]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="1490" width="1201" height="35" as="geometry"/></mxCell><mxCell id="31" value="10. Loại, tóm tắt, ngày gửi, trạng thái" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1556" as="sourcePoint"/><mxPoint x="470" y="1556" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="11. Hiển thị danh sách" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1656" as="sourcePoint"/><mxPoint x="110" y="1656" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="12. Chọn một báo cáo" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1756" as="sourcePoint"/><mxPoint x="470" y="1756" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" value="13. Yêu cầu chi tiết báo cáo" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1856" as="sourcePoint"/><mxPoint x="830" y="1856" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" value="14. Đọc báo cáo và kiểm tra người sở hữu" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1956" as="sourcePoint"/><mxPoint x="1190" y="1956" as="targetPoint"/></mxGeometry></mxCell><mxCell id="39" value="[Không tồn tại / thuộc Student khác — E2]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="134" y="2078" width="1177" height="35" as="geometry"/></mxCell><mxCell id="41" value="15. Báo cáo thiếu hoặc không thuộc Student" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="2144" as="sourcePoint"/><mxPoint x="830" y="2144" as="targetPoint"/></mxGeometry></mxCell><mxCell id="43" value="16. T