="34" as="geometry"/></mxCell><mxCell id="26" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="824" y="1326" width="12" height="34" as="geometry"/></mxCell><mxCell id="28" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="1426" width="12" height="34" as="geometry"/></mxCell><mxCell id="37" value="" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="464" y="1890" width="12" height="34" as="geometry"/></mxCell><mxCell id="6" value="1. Mở Phản hồi &amp; Báo lỗi hệ thống" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="240" as="sourcePoint"/><mxPoint x="470" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8" value="2. Yêu cầu tải danh sách theo tiêu chí hiện tại" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="340" as="sourcePoint"/><mxPoint x="830" y="340" as="targetPoint"/></mxGeometry></mxCell><mxCell id="10" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="430" width="60" height="28" as="geometry"/></mxCell><mxCell id="11" value="Xác thực phiên/JWT và quyền đúng vai trò — §4.2.4, §5.2.1. Không hợp lệ: chặn truy cập theo quy định chung." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="432" width="1210" height="66" as="geometry"/></mxCell><mxCell id="13" value="3. Chỉ truy vấn technical bug / lỗi UI / sự cố nền tảng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="538" as="sourcePoint"/><mxPoint x="1190" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="4. Kết quả truy vấn" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="638" as="sourcePoint"/><mxPoint x="830" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="5. Ticket ID, tên/email người gửi, loại, tiêu đề, ngày tạo, trạng thái" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="738" as="sourcePoint"/><mxPoint x="470" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="6. Hiển thị danh sách / trạng thái rỗng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="838" as="sourcePoint"/><mxPoint x="110" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="19" value="[Tìm kiếm / lọc / phân trang]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="960" width="1225" height="35" as="geometry"/></mxCell><mxCell id="21" value="7. Chọn Chờ xử lý / Đang xử lý / Đã giải quyết / Từ chối; tìm kiếm hoặc chuyển trang theo §5.2.3" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1026" as="sourcePoint"/><mxPoint x="470" y="1026" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="8. Yêu cầu danh sách với tiêu chí" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1126" as="sourcePoint"/><mxPoint x="830" y="1126" as="targetPoint"/></mxGeometry></mxCell><mxCell id="25" value="9. Truy vấn technical feedback theo trạng thái / từ khóa / trang" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1226" as="sourcePoint"/><mxPoint x="1190" y="1226" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="10. Kết quả" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="1326" as="sourcePoint"/><mxPoint x="830" y="1326" as="targetPoint"/></mxGeometry></mxCell><mxCell id="29" value="11. Danh sách tương ứng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1426" as="sourcePoint"/><mxPoint x="470" y="1426" as="targetPoint"/></mxGeometry></mxCell><mxCell id="30" value="12. Làm mới bảng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1526" as="sourcePoint"/><mxPoint x="110" y="1526" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="opt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="923" width="68" height="28" as="geometry"/></mxCell><mxCell id="33" value="[Không có phản ánh kỹ thuật chưa xử lý — 2a]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="1686" width="1225" height="35" as="geometry"/></mxCell><mxCell id="34" value="13. Hiện không có phản ánh kỹ thuật nào chưa xử lý. (MSG18)" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1752" as="sourcePoint"/><mxPoint x="110" y="1752" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" value="opt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1649" width="68" height="28" as="geometry"/></mxCell><mxCell id="38" value="14. Chọn một dòng phản hồi" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1890" as="sourcePoint"/><mxPoint x="470" y="1890" as="targetPoint"/></mxGeometry></mxCell><mxCell id="40" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="1980" width="60" height="28" as="geometry"/></mxCell><mxCell id="41" value="SD-17.5 — mở chi tiết và xử lý technical feedback (UC-64)" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1982" width="1210" height="66" as="geometry"/></mxCell><mxCell id="42" value="Chỉ đọc; không lấy phản hồi học thuật. UC-63 ghi UC-75 trong bước 4, còn bảng đối chiếu là UC-64; không phát sinh UC-75." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="2078" width="1290" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="SD-17.5" name="SD-17.5 Resolve technical feedback"><mxGraphModel grid="0" page="1" pageScale="1" pageWidth="1740" pageHeight="3385" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="SD-17.5  Resolve technical feedback" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28" y="12" width="1685" height="38" as="geometry"/></mxCell><mxCell id="3" value="Nguồn: SRS §2.4.64 (UC-64); §5.2 Common Requirements. Điều kiện: Administrator đã đăng nhập, có đúng vai trò/quyền theo UC." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;" vertex="1" parent="1"><mxGeometry x="28" y="58" width="1685" height="42" as="geometry"/></mxCell><mxCell id="4" value="Mức tương tác theo yêu cầu SRS: các lifeline Giao diện / Hệ thống / CSDL là vai trò logic, không khẳng định tên class, API hoặc bảng chưa được đặc tả. Mũi tên liền: yêu cầu; nét đứt: phản hồi." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="28" y="108" width="1685" height="40" as="geometry"/></mxCell><mxCell id="67" value="Administrator" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="40" height="48" as="geometry"/></mxCell><mxCell id="68" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="230" as="sourcePoint"/><mxPoint x="110" y="3350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="69" value="Giao diện" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="260" height="48" as="geometry"/></m