rgetPoint"/></mxGeometry></mxCell><mxCell id="32" value="10. Cập nhật thành công (MSG31)" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1519" as="sourcePoint"/><mxPoint x="470" y="1519" as="targetPoint"/></mxGeometry></mxCell><mxCell id="33" value="11. Hiển thị thành công" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1619" as="sourcePoint"/><mxPoint x="110" y="1619" as="targetPoint"/></mxGeometry></mxCell><mxCell id="35" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="945" width="68" height="28" as="geometry"/></mxCell><mxCell id="37" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="1747" width="60" height="28" as="geometry"/></mxCell><mxCell id="38" value="Audit quản trị theo §4.2.4, BR-07." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="1749" width="1210" height="66" as="geometry"/></mxCell><mxCell id="39" value="Thuật ngữ nguồn chưa thống nhất: UC-55 gọi mốc chuỗi đăng nhập, BR-99 gọi chuỗi ngày học từ hoạt động hợp lệ. Sơ đồ chỉ quản lý cấu hình mốc theo UC-55; không suy diễn điều kiện tăng streak hoặc phát xu." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middl