s="geometry"/></mxCell><mxCell id="6" value="1. Mở ticket technical feedback" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="240" as="sourcePoint"/><mxPoint x="470" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="8" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="330" width="60" height="28" as="geometry"/></mxCell><mxCell id="9" value="Xác thực phiên/JWT và quyền Administrator — §4.2.4, §5.2.1. Không hợp lệ: chặn truy cập theo quy định chung." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="332" width="1570" height="66" as="geometry"/></mxCell><mxCell id="11" value="2. Yêu cầu chi tiết ticket" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="438" as="sourcePoint"/><mxPoint x="830" y="438" as="targetPoint"/></mxGeometry></mxCell><mxCell id="13" value="3. Truy vấn phản hồi kỹ thuật được chọn" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="538" as="sourcePoint"/><mxPoint x="1190" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="4. Mô tả, screenshot đính kèm và thông tin thiết bị theo UC-64" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="638" as="sourcePoint"/><mxPoint x="830" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="5. Chi tiết phản hồi" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="738" as="sourcePoint"/><mxPoint x="470" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="6. Hiển thị chi tiết" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="838" as="sourcePoint"/><mxPoint x="110" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="20" value="7. Chọn Đang xử lý / Đã xử lý / Từ chối; nhập ghi chú" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="938" as="sourcePoint"/><mxPoint x="470" y="938" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="8. Chọn Cập nhật trạng thái" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="1038" as="sourcePoint"/><mxPoint x="470" y="1038" as="targetPoint"/></mxGeometry></mxCell><mxCell id="24" value="9. Kiểm tra phía client; trim ghi chú" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1138" as="sourcePoint"/><mxPoint x="476" y="1176" as="targetPoint"/><Array as="points"><mxPoint x="595" y="1138"/><mxPoint x="595" y="1176"/></Array></mxGeometry></mxCell><mxCell id="26" value="10. Gửi trạng thái và ghi chú xử lý" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1250" as="sourcePoint"/><mxPoint x="830" y="1250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="28" value="11. Sanitize ghi chú; kiểm tra ghi chú không trống theo bước 5 UC-64" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=285;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1350" as="sourcePoint"/><mxPoint x="836" y="1388" as="targetPoint"/><Array as="points"><mxPoint x="955" y="1350"/><mxPoint x="955" y="1388"/></Array></mxGeometry></mxCell><mxCell id="29" value="[Ghi chú trống — bước 5; luồng 5a nêu Resolved/Rejected]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="1484" width="1585" height="35" as="geometry"/></mxCell><mxCell id="31" value="12. Lỗi bắt buộc ghi chú (MSG09)" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1550" as="sourcePoint"/><mxPoint x="470" y="1550" as="targetPoint"/></mxGeometry></mxCell><mxCell id="32" value="13. Tô đỏ trường; ngăn lưu" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="1650" as="sourcePoint"/><mxPoint x="110" y="1650" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="[Ghi chú hợp lệ]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="110" y="1755" width="1585" height="35" as="geometry"/></mxCell><mxCell id="36" value="14. Lưu trạng thái xử lý và ghi chú" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="1821" as="sourcePoint"/><mxPoint x="1190" y="1821" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" value="15. Dữ liệu xử lý đã lưu" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="1921" as="sourcePoint"/><mxPoint x="830" y="1921" as="targetPoint"/></mxGeometry></mxCell><mxCell id="40" value="16. Tạo thông báo in-app cho Student" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2021" as="sourcePoint"/><mxPoint x="1190" y="2021" as="targetPoint"/></mxGeometry></mxCell><mxCell id="42" value="17. Thông báo được ghi nhận" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="2121" as="sourcePoint"/><mxPoint x="830" y="2121" as="targetPoint"/></mxGeometry></mxCell><mxCell id="44" value="18. Gửi email thông báo kết quả đến Student" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=682;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2221" as="sourcePoint"/><mxPoint x="1550" y="2221" as="targetPoint"/></mxGeometry></mxCell><mxCell id="45" value="[Gửi email thành công]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="2343" width="1561" height="35" as="geometry"/></mxCell><mxCell id="47" value="19. Kết quả gửi thành công" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=682;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="2409" as="sourcePoint"/><mxPoint x="830" y="2409" as="targetPoint"/></mxGeometry></mxCell><mxCell id="49" value="[Gửi email lỗi — 6a]" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontStyle=2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="122" y="2514" width="1561" height="35" as="geometry"/></mxCell><mxCell id="51" value="20. Email exception" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=682;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1550" y="2580" as="sourcePoint"/><mxPoint x="830" y="2580" as="targetPoint"/></mxGeometry></mxCell><mxCell id="53" value="21. Ghi log lỗi email; vẫn giữ trạng thái xử lý đã commit" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2680" as="sourcePoint"/><mxPoint x="1190" y="2680" as="targetPoint"/></mxGeometry></mxCell><mxCell id="55" value="22. Log được ghi nhận" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="2780" as="sourcePoint"/><mxPoint x="830" y="2780" as="targetPoint"/></mxGeometry></mxCell><mxCell id="57" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="42" y="2306" width="68" height="28" as="geometry"/></mxCell><mxCell id="59" value="23. Cập nhật tiến độ xử lý phản hồi thành công! (MSG17)" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="2918" as="sourcePoint"/><mxPoint x="470" y="2918" as="targetPoint"/></mxGeometry></mxCell><mxCell id="60" value="24. Hiển thị thành công" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="3018" as="sourcePoint"/><mxPoint x="110" y="3018" as="targetPoint"/></mxGeometry></mxCell><mxCell id="62" value="alt" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1447" width="68" height="28" as="geometry"/></mxCell><mxCell id="64" value="ref" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlFrame;align=left;spacingLeft=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="35" y="3146" width="60" height="28" as="geometry"/></mxCell><mxCell id="65" value="Audit bất biến cho can thiệp quản trị — §4.2.4, BR-07." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="3148" width="1570" height="66" as="geometry"/></mxCell><mxCell id="66" value="Điểm chưa thống nhất, không tự sửa: bước 5 UC-64 yêu cầu ghi chú không trống; 5a và BR-54 chỉ nhấn mạnh Resolved/Rejected. Bước 6 gửi in-app/email sau cập nhật. UC-64 tham chiếu UC-74 và BR-48; phụ lục tương ứng về feedback là BR-54. Không thêm cơ chế retry email hoặc optimistic locking vì UC-64 không nêu." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="3244" width="1650" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram>
<diagram id="SD-32.1" name="SD-32.1 View coin reward rules"><mxGraphModel grid="0" page="1" pageScale="1" pageWidth="1380" pageHeight="1061" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="SD-32.1  View coin reward rules" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28" y="12" width="1325" height="38" as="geometry"/></mxCell><mxCell id="3" value="Nguồn: SRS §2.4.54 (UC-54); §5.2 Common Requirements. Điều kiện: Administrator đã đăng nhập, có đúng vai trò/quyền theo UC." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;" vertex="1" parent="1"><mxGeometry x="28" y="58" width="1325" height="42" as="geometry"/></mxCell><mxCell id="4" value="Mức tương tác theo yêu cầu SRS: các lifeline Giao diện / Hệ thống / CSDL là vai trò logic, không khẳng định tên class, API hoặc bảng chưa được đặc tả. Mũi tên liền: yêu cầu; nét đứt: phản hồi." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="28" y="108" width="1325" height="40" as="geometry"/></mxCell><mxCell id="20" value="Administrator" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="40" height="48" as="geometry"/></mxCell><mxCell id="21" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="230" as="sourcePoint"/><mxPoint x="110" y="1026" as="targetPoint"/></mxGeometry></mxCell><mxCell id="22" value="Giao diện" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="260" height="48" as="geometry"/></mxCell><m