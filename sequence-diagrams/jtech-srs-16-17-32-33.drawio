<diagram id="SD-16.2" name="SD-16.2 View my feedback"><mxGraphModel grid="0" page="1" pageScale="1" pageWidth="1380" pageHeight="3975" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="SD-16.2  View my feedback" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="28" y="12" width="1325" height="38" as="geometry"/></mxCell><mxCell id="3" value="Nguồn: SRS §2.4.35 (UC-35); §5.2 Common Requirements. Điều kiện: Student đã đăng nhập, có đúng vai trò/quyền theo UC." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;" vertex="1" parent="1"><mxGeometry x="28" y="58" width="1325" height="42" as="geometry"/></mxCell><mxCell id="4" value="Mức tương tác theo yêu cầu SRS: các lifeline Giao diện / Hệ thống / CSDL là vai trò logic, không khẳng định tên class, API hoặc bảng chưa được đặc tả. Mũi tên liền: yêu cầu; nét đứt: phản hồi." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;text;align=left;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="28" y="108" width="1325" height="40" as="geometry"/></mxCell><mxCell id="76" value="Student" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="40" height="48" as="geometry"/></mxCell><mxCell id="77" value="" style="html=0;fontFamily=Arial;fontSize=14;endArrow=none;dashed=1;strokeColor=#888888;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110" y="230" as="sourcePoint"/><mxPoint x="110" y="3940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="78" value="Giao diện" style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;rounded=0;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="170" width="260" height="48" as="geometry"/></mxCell><mxCell id="79" value="" s