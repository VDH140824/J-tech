middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="105" y="432" width="1210" height="66" as="geometry"/></mxCell><mxCell id="13" value="3. Truy vấn mức xu thưởng và trạng thái On/Off theo từng loại hoạt động" style="html=0;fontFamily=Arial;fontSize=14;endArrow=block;endFill=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="538" as="sourcePoint"/><mxPoint x="1190" y="538" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="4. Kết quả truy vấn" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190" y="638" as="sourcePoint"/><mxPoint x="830" y="638" as="targetPoint"/></mxGeometry></mxCell><mxCell id="17" value="5. Mức thưởng hiện tại và trạng thái áp dụng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="738" as="sourcePoint"/><mxPoint x="470" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="18" value="6. Hiển thị danh sách / trạng thái rỗng" style="html=0;fontFamily=Arial;fontSize=14;endArrow=open;endFill=0;dashed=1;strokeColor=#222222;whiteSpace=wrap;labelWidth=322;labelBackgroundColor=#ffffff;verticalAlign=bottom;spacingBottom=7;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="470" y="838" as="sourcePoint"/><mxPoint x="110" y="838" as="targetPoint"/></mxGeometry></mxCell><mxCell id="19" value="Loại hoạt động theo UC-54: lecture exercises, lesson tests, chapter tests, listening, reading, conjugation và games. Màn hình chỉ xem; không cấp xu và không thay đổi ví." style="html=0;fontFamily=Arial;fontSize=14;whiteSpace=wrap;shape=note;align=left;verticalAlign=middle;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="35" y="928" width="1290" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram>
