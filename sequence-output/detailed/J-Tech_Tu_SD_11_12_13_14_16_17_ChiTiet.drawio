ông hợp lệ — NF5 / A3a]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127" y="1542" width="3085" height="28" as="geometry"/></mxCell><mxCell id="52" value="alt" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="25" y="2205" width="90" height="30" as="geometry"/></mxCell><mxCell id="53" value="[ticket vừa được Moderator khác cập nhật — A4a]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127" y="2207" width="3085" height="28" as="geometry"/></mxCell><mxCell id="56" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2179" y="2140" width="12" height="160" as="geometry"/></mxCell><mxCell id="66" value="[cập nhật thành công]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="125" y="2950" width="3085" height="28" as="geometry"/></mxCell><mxCell id="73" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2589" y="3166" width="12" height="105" as="geometry"/></mxCell><mxCell id="78" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2999" y="3376" width="12" height="105" as="geometry"/></mxCell><mxCell id="87" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="551" y="3970" width="12" height="45" as="geometry"/></mxCell><mxCell id="14" value="1: Xem báo lỗi; chọn Đang xử lý / Đã xử lý / Từ chối" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=