calAlign=middle;fontFamily=Arial;fontSize=14;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="98" width="2785" height="27" as="geometry"/></mxCell><mxCell id="5" value="Tiền điều kiện: phiên hợp lệ, đúng vai trò; Student Active. §5.2.1 quy định JWT cho các yêu cầu được bảo vệ. BR109: chỉ đọc, không cập nhật streak hay cấp coin. UC-27 gọi “login streak”; BR108 gọi “learning streak”." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="2785" height="27" as="geometry"/></mxCell><mxCell id="25" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2179" y="835" width="12" height="105" as="geometry"/></mxCell><mxCell id="30" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2589" y="1045" width="12" height="105" as="geometry"/></mxCell><mxCell id="33" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1781" y="1244" width="12" height="45" as="geometry"/></mxCell><mxCell id="35" value="alt" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="25" y="1340" width="90" height="30" as="geometry"/></mxCell><mxCell id="36" value="[có mốc thưởng tiếp theo]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127" y="1342" width="2675" height="28" as="geometry"/></mxCell><mxCell id="46" value="[không có mốc tiếp theo — A1]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="125" y="1900" width="2675" heig