phân rã trách nhiệm UML; không khẳng định tên file, lớp, method, endpoint hay mã HTTP mà SRS không quy định." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="98" width="2375" height="27" as="geometry"/></mxCell><mxCell id="5" value="Tiền điều kiện: Administrator đã đăng nhập. UC-63 ghi trạng thái “Đã giải quyết”; UC-64 dùng “Đã xử lý”. UC-63 dẫn UC-75 nhưng chức năng tương ứng là UC-64." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="2375" height="27" as="geometry"/></mxCell><mxCell id="22" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1781" y="844" width="12" height="45" as="geometry"/></mxCell><mxCell id="27" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2179" y="980" width="12" height="105" as="geometry"/></mxCell><mxCell id="37" value="opt" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="25" y="1630" width="90" height="30" as="geometry"/></mxCell><mxCell id="38" value="[không có phản ánh kỹ thuật chưa xử lý — A2a]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127" y="1632" width="2265" height="28" as="geometry"/></mxCell><mxCell id="41" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="551" y="1714" width="12" height="45" as="geometry"/></mxCell><mxCell id="45" value="loop" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15