Color=none;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="2785" height="38" as="geometry"/></mxCell><mxCell id="3" value="Nguồn: UC-31 NF1–6, A1–A4, E1–E2; §3.1.5 user_inventory" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="58" width="2785" height="28" as="geometry"/></mxCell><mxCell id="4" value="Mô hình tương tác logic từ SRS. Boundary / API / control là phân rã trách nhiệm UML; không khẳng định tên file, lớp, method, endpoint hay mã HTTP mà SRS không quy định." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="98" width="2785" height="27" as="geometry"/></mxCell><mxCell id="5" value="Tiền điều kiện: phiên hợp lệ, đúng vai trò; Student Active. §5.2.1 quy định JWT cho các yêu cầu được bảo vệ. UC-31 đề xuất IT material; BR143 chỉ nêu avatar / streak-freeze. Không tự bổ sung quy tắc về thời hạn entitlement." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="2785" height="27" as="geometry"/></mxCell><mxCell id="24" value="break" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="25" y="960" width="90" height="30" as="geometry"/></mxCell><mxCell id="25" value="[không tải được inventory — E1]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127" y="962" width="2675" height="28" as="geometry"/></mxCell><mxCell id="28" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"