 control lifelines represent responsibilities, not unspecified code classes, methods, endpoints or HTTP status codes. UI labels and messages are translated into English for these diagrams; SRS message IDs are retained." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="98" width="1555" height="46" as="geometry"/></mxCell><mxCell id="5" value="BR45 specifies streak milestone rewards; NS-08 describes exercise / game completion. No unspecified key algorithm, EXP amount, SQL, endpoint or coin amount is introduced." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=14;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="149" width="1555" height="27" as="geometry"/></mxCell><mxCell id="15" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="551" y="609" width="12" height="45" as="geometry"/></mxCell><mxCell id="17" value="critical" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="25" y="705" width="90" height="30" as="geometry"/></mxCell><mxCell id="18" value="[ACID transaction with idempotency protection — NS-08 / Section 4]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="127" y="707" width="1445" height="28" as="geometry"/></mxCell><mxCell id="23" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="949" y="820" width="12" height="105" as="geometry"/></mxCell><mxCell id="25" value="alt" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="39" y="990" width="90" height="30" as="geometry"/></mxCell><mxCell id="26" value="[the award key already exists]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="141" y="992" width="1417" height="28" as="geometry"/></mxCell><mxCell id="29" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="551" y="1094" width="12" height="45" as="geometry"/></mxCell><mxCell id="33" value="[the award key does not exist]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="139" y="1320" width="1417" height="28" as="geometry"/></mxCell><mxCell id="38" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1359" y="1411" width="12" height="105" as="geometry"/></mxCell><mxCell id="42" value="alt" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="53" y="1726" width="90" height="30" as="geometry"/></mxCell><mxCell id="43" value="[all updates succeed]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="155" y="1728" width="1389" height="28" as="geometry"/></mxCell><mxCell id="46" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="949" y="1661" width="12" height="160" as="geometry"/></mxCell><mxCell id="49" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="551" y="1915" width="12" height="45" as="geometry"/></mxCell><mxCell id="53" value="[the transaction cannot be completed]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="153" y="2121" width="1389" height="28" as="geometry"/></mxCell><mxCell id="58" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="551" y="2326" width="12" height="45" as="geometry"/></mxCell><mxCell id="10" value="1: Request a reward after exercise / game completion — NS-08" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="355" width="378" height="48" as="geometry"/></mxCell><mxCell id="11" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="142" y="415" as="sourcePoint"/><mxPoint x="538" y="415" as="targetPoint"/></mxGeometry></mxCell><mxCell id="13" value="2: Use an idempotency award key; its format is not specified by the SRS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="661" y="560" width="275" height="68" as="geometry"/></mxCell><mxCell id="14" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="614" as="sourcePoint"/><mxPoint x="558" y="644" as="targetPoint"/><Array as="points"><mxPoint x="640" y="614"/><mxPoint x="640" y="644"/></Array></mxGeometry></mxCell><mxCell id="19" value="3: Check whether the award key has already been recorded in the ledger" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="561" y="760" width="378" height="48" as="geometry"/></mxCell><mxCell id="20" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="820" as="sourcePoint"/><mxPoint x="948" y="820" as="targetPoint"/></mxGeometry></mxCell><mxCell id="21" value="4: Award key exists / does not exist" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="561" y="885" width="378" height="28" as="geometry"/></mxCell><mxCell id="22" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="948" y="925" as="sourcePoint"/><mxPoint x="552" y="925" as="targetPoint"/></mxGeometry></mxCell><mxCell id="27" value="5: Do not allocate additional coins / EXP or create another ledger entry" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="661" y="1045" width="275" height="68" as="geometry"/></mxCell><mxCell id="28" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="1099" as="sourcePoint"/><mxPoint x="558" y="1129" as="targetPoint"/><Array as="points"><mxPoint x="640" y="1099"/><mxPoint x="640" y="1129"/></Array></mxGeometry></mxCell><mxCell id="30" value="6: Do not grant a duplicate reward for the same key" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="1190" width="378" height="48" as="geometry"/></mxCell><mxCell id="31" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="538" y="1250" as="sourcePoint"/><mxPoint x="142" y="1250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="34" value="7: Credit profile EXP and coin balance within the transaction" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="561" y="1371" width="788" height="28" as="geometry"/></mxCell><mxCell id="35" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="1411" as="sourcePoint"/><mxPoint x="1358" y="1411" as="targetPoint"/></mxGeometry></mxCell><mxCell id="36" value="8: Profile / balance update result" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="561" y="1476" width="788" height="28" as="geometry"/></mxCell><mxCell id="37" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1358" y="1516" as="sourcePoint"/><mxPoint x="552" y="1516" as="targetPoint"/></mxGeometry></mxCell><mxCell id="39" value="9: Record an immutable entry: EARN, amount, post-transaction balance, source activity and idempotency key" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="561" y="1581" width="378" height="68" as="geometry"/></mxCell><mxCell id="40" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="1661" as="sourcePoint"/><mxPoint x="948" y="1661" as="targetPoint"/></mxGeometry></mxCell><mxCell id="44" value="10: Ledger entry recorded" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="561" y="1781" width="378" height="28" as="geometry"/></mxCell><mxCell id="45" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="948" y="1821" as="sourcePoint"/><mxPoint x="552" y="1821" as="targetPoint"/></mxGeometry></mxCell><mxCell id="47" value="11: Commit the ACID transaction" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="661" y="1886" width="275" height="48" as="geometry"/></mxCell><mxCell id="48" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="1920" as="sourcePoint"/><mxPoint x="558" y="1950" as="targetPoint"/><Array as="points"><mxPoint x="640" y="1920"/><mxPoint x="640" y="1950"/></Array></mxGeometry></mxCell><mxCell id="50" value="12: Committed reward allocation result" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="2011" width="378" height="28" as="geometry"/></mxCell><mxCell id="51" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="538" y="2051" as="sourcePoint"/><mxPoint x="142" y="2051" as="targetPoint"/></mxGeometry></mxCell><mxCell id="54" value="13: Transaction failed" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="561" y="2172" width="378" height="28" as="geometry"/></mxCell><mxCell id="55" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="948" y="2212" as="sourcePoint"/><mxPoint x="552" y="2212" as="targetPoint"/></mxGeometry></mxCell><mxCell id="56" value="14: Roll back the changes; do not a