tPoint"/></mxGeometry></mxCell><mxCell id="66" value="16: Determine consecutive learning days from qualifying recorded completions" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1891" y="2521" width="275" height="68" as="geometry"/></mxCell><mxCell id="67" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1782" y="2575" as="sourcePoint"/><mxPoint x="1788" y="2605" as="targetPoint"/><Array as="points"><mxPoint x="1870" y="2575"/><mxPoint x="1870" y="2605"/></Array></mxGeometry></mxCell><mxCell id="69" value="17: Update the learning streak at most once per calendar day" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1791" y="2666" width="1198" height="28" as="geometry"/></mxCell><mxCell id="70" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1782" y="2706" as="sourcePoint"/><mxPoint x="2998" y="2706" as="targetPoint"/></mxGeometry></mxCell><mxCell id="71" value="18: Updated learning streak" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1791" y="2771" width="1198" height="28" as="geometry"/></mxCell><mxCell id="72" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="2998" y="2811" as="sourcePoint"/><mxPoint x="1782" y="2811" as="targetPoint"/></mxGeometry></mxCell><mxCell id="74" value="19: Read milestones and identify a milestone not yet rewarded within this unbroken streak" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle