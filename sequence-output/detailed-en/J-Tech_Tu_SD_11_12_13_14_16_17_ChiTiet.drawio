ht="30" as="geometry"/></mxCell><mxCell id="77" value="[required information is missing or the content reference is invalid — E1]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="141" y="3299" width="2647" height="28" as="geometry"/></mxCell><mxCell id="87" value="break" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="39" y="3897" width="90" height="30" as="geometry"/></mxCell><mxCell id="88" value="[an attachment violates the file rules — E2]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="141" y="3899" width="2647" height="28" as="geometry"/></mxCell><mxCell id="100" value="alt" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="39" y="4622" width="90" height="30" as="geometry"/></mxCell><mxCell id="101" value="[the report and attachments are saved successfully]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="141" y="4624" width="2647" height="28" as="geometry"/></mxCell><mxCell id="104" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="2589" y="4557" width="12" height="160" as="geometry"/></mxCell><mxCell id="106" value="alt" style="shape=umlFrame;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontFamily=Arial;fontSize=15;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="53" y="4782" width="90" height="30" as="geometry"/></mxCell><mxCell id="107" value="[Content Feedback]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="155" y="4784" width="2619" height="28" as="geometry"/></mxCell><mxCell id="110" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1781" y="4866" width="12" height="45" as="geometry"/></mxCell><mxCell id="112" value="[Technical Issue]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="153" y="4967" width="2619" height="28" as="geometry"/></mxCell><mxCell id="115" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1781" y="5047" width="12" height="45" as="geometry"/></mxCell><mxCell id="125" value="[the report or attachments cannot be saved — E3]" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="139" y="5613" width="2647" height="28" as="geometry"/></mxCell><mxCell id="136" value="" style="fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="551" y="6133" width="12" height="45" as="geometry"/></mxCell><mxCell id="13" value="1: Open Send Feedback / Report a Bug" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="355" width="378" height="28" as="geometry"/></mxCell><mxCell id="14" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="142" y="395" as="sourcePoint"/><mxPoint x="538" y="395" as="targetPoint"/></mxGeometry></mxCell><mxCell id="15" value="2: Display categories, description, content reference fields and optional image attachments" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="661" y="460" width="275" height="88" as="geometry"/></mxCell><mxCell id="16" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="534" as="sourcePoint"/><mxPoint x="558" y="564" as="targetPoint"/><Array as="points"><mxPoint x="640" y="534"/><mxPoint x="640" y="564"/></Array></mxGeometry></mxCell><mxCell id="18" value="3: Select Content Feedback or Technical Issue" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="625" width="378" height="48" as="geometry"/></mxCell><mxCell id="19" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="142" y="685" as="sourcePoint"/><mxPoint x="538" y="685" as="targetPoint"/></mxGeometry></mxCell><mxCell id="23" value="4: Allow lesson / lecture / question selection; prefill the reference when opened from a content page" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="661" y="805" width="275" height="88" as="geometry"/></mxCell><mxCell id="24" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="879" as="sourcePoint"/><mxPoint x="558" y="909" as="targetPoint"/><Array as="points"><mxPoint x="640" y="879"/><mxPoint x="640" y="909"/></Array></mxGeometry></mxCell><mxCell id="26" value="5: Select / review the referenced content" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="970" width="378" height="28" as="geometry"/></mxCell><mxCell id="27" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="142" y="1010" as="sourcePoint"/><mxPoint x="538" y="1010" as="targetPoint"/></mxGeometry></mxCell><mxCell id="30" value="6: Allow an affected-function description; no content reference is required" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="661" y="1131" width="275" height="68" as="geometry"/></mxCell><mxCell id="31" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="1185" as="sourcePoint"/><mxPoint x="558" y="1215" as="targetPoint"/><Array as="points"><mxPoint x="640" y="1185"/><mxPoint x="640" y="1215"/></Array></mxGeometry></mxCell><mxCell id="33" value="7: Enter the description and optionally attach images" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="1321" width="378" height="48" as="geometry"/></mxCell><mxCell id="34" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="142" y="1381" as="sourcePoint"/><mxPoint x="538" y="1381" as="targetPoint"/></mxGeometry></mxCell><mxCell id="38" value="8: Cancel submission" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="1501" width="378" height="28" as="geometry"/></mxCell><mxCell id="39" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="142" y="1541" as="sourcePoint"/><mxPoint x="538" y="1541" as="targetPoint"/></mxGeometry></mxCell><mxCell id="40" value="9: Leave the form without creating a report" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="661" y="1606" width="275" height="48" as="geometry"/></mxCell><mxCell id="41" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="1640" as="sourcePoint"/><mxPoint x="558" y="1670" as="targetPoint"/><Array as="points"><mxPoint x="640" y="1640"/><mxPoint x="640" y="1670"/></Array></mxGeometry></mxCell><mxCell id="45" value="10: Submit" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="1787" width="378" height="28" as="geometry"/></mxCell><mxCell id="46" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="142" y="1827" as="sourcePoint"/><mxPoint x="538" y="1827" as="targetPoint"/></mxGeometry></mxCell><mxCell id="47" value="11: Trim input; validate required information and attachments under the common requirements" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="661" y="1892" width="275" height="88" as="geometry"/></mxCell><mxCell id="48" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="1966" as="sourcePoint"/><mxPoint x="558" y="1996" as="targetPoint"/><Array as="points"><mxPoint x="640" y="1966"/><mxPoint x="640" y="1996"/></Array></mxGeometry></mxCell><mxCell id="53" value="12: Identify the problem; request corrected information or attachment removal / replacement" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="151" y="2112" width="378" height="68" as="geometry"/></mxCell><mxCell id="54" style="endArrow=open;endFill=0;dashed=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="538" y="2192" as="sourcePoint"/><mxPoint x="142" y="2192" as="targetPoint"/></mxGeometry></mxCell><mxCell id="55" value="13: Send category, description, reference where applicable and optional images" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="561" y="2302" width="378" height="48" as="geometry"/></mxCell><mxCell id="56" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="2362" as="sourcePoint"/><mxPoint x="948" y="2362" as="targetPoint"/></mxGeometry></mxCell><mxCell id="57" value="14: Forward the report submission with the authenticated session" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="971" y="2427" width="378" height="48" as="geometry"/></mxCell><mxCell id="58" style="endArrow=block;endFill=1;strokeColor=#000000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="962" y="2487" as="sourcePoint"/><mxPoint x="1358" y="2487" as="targetPoint"/></mxGeometry></mxCell><mxCell id="59" value="15: Validate input on the server; trim / sanitize user-generated text" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;spacing=6;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1481" y="2552" width="2